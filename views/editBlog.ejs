<h1>Edit Blog</h1>

<% if (blog) { %>

<form action="/editBlog/<%= id %>" method="POST">
    <input type="text" name="title" value="<%= blog.Title %>" required>
    <input type="text" name="author" value="<%= blog.Author %>" required>
    <textarea name="blogDescription"><%= blog.Desc %></textarea>
    <textarea name="blogContent"><%= blog.Blog %></textarea>
    <button type="submit">Update</button>
</form>

<% } else { %>
    <p>Blog not found</p>
<% } %>
